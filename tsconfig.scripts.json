{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2020",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src/scripts",
    "outDir": "public/assets/js",
    "skipLibCheck": true
  },
  "include": [
    "src/scripts/**/*.ts"
  ]
}
