---
type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type HeadingVariant =
  | "default"
  | "page"
  | "section"
  | "subsection"
  | "border"
  | "colored"
  | "background";

interface Props {
  as?: HeadingTag;
  variant?: HeadingVariant;
  class?: string;
}

const {
  as = "h2",
  variant = "default",
  class: className = "",
} = Astro.props;

const Tag = as;
---

<Tag
  class:list={[
    "c-heading",
    `c-heading--${variant}`,
    className,
  ]}
>
  <slot />
</Tag>
