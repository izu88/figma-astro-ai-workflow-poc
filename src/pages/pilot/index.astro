---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PilotHeader from "../../components/pilot/PilotHeader.astro";
import PilotFooter from "../../components/pilot/PilotFooter.astro";
import Heading from "../../components/base/Heading.astro";
import Text from "../../components/base/Text.astro";
import Button from "../../components/base/Button.astro";
import Card from "../../components/patterns/Card.astro";
import Media from "../../components/patterns/Media.astro";
import Hero from "../../components/sections/Hero.astro";
import Section from "../../components/sections/Section.astro";

const meta = {
  siteName: "NAGI STUDIO",
  title: "ホーム",
  description: "Figma Design SystemからAstroへ実装した2ページ構成の検証サイトです。",
};
---

<BaseLayout meta={meta} bodyClass="page-pilot">
  <PilotHeader slot="header" active="home" />
  <main class="p-pilot" id="main-content">
    <Hero variant="subtle" class="p-pilot-hero">
      <Text variant="label" class="p-pilot-eyebrow">DESIGN × TECHNOLOGY</Text>
      <Heading as="h1" variant="page">つくるを、自由に。</Heading>
      <p class="p-pilot-hero__lead">デザインと実装をつなぎ、伝わるWeb体験をつくる。</p>
      <Button href="/pilot/services/" variant="primary">サービスを見る</Button>
    </Hero>

    <Section class="p-pilot-section">
      <Heading as="h2" variant="section">私たちの取り組み</Heading>
      <p class="p-pilot-intro">設計と実装の両方から、制作の質と速度を高めます。</p>
      <div class="p-pilot-cards">
        <Card variant="default" class="p-pilot-card">
          <Heading as="h3" variant="subsection">Design System</Heading>
          <p>一貫した体験を支える共通の設計ルール。</p>
        </Card>
        <Card variant="subtle" class="p-pilot-card">
          <Heading as="h3" variant="subsection">Web Engineering</Heading>
          <p>柔軟で保守しやすいサイト制作。</p>
        </Card>
      </div>
    </Section>

    <Section variant="subtle" class="p-pilot-section p-pilot-section--media">
      <Media variant="image-right" class="p-pilot-media">
        <div slot="media" class="p-pilot-media__placeholder" aria-hidden="true">Media</div>
        <Heading as="h2" variant="colored">デザインから公開まで</Heading>
        <p>共通コンポーネントを軸に、設計・実装・検証をつなぎます。</p>
      </Media>
    </Section>
  </main>
  <PilotFooter slot="footer" />
</BaseLayout>
